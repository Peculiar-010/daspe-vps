# Server
PORT=3000
NODE_ENV=production
BASE_URL=https://daspe.name.ng
FRONTEND_URL=https://daspe.name.ng

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=daspe_db
DB_USER=daspe
DB_PASSWORD=your_postgres_password

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://daspe.name.ng/auth/github/callback

# Session
SESSION_SECRET=your_super_long_random_session_secret_here

# JWT
JWT_SECRET=your_super_long_random_jwt_secret_here

# Encryption (for user env variables) - must be 32 chars
ENCRYPTION_KEY=your_32_character_encryption_key_

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id

# Web Push VAPID Keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:admin@daspe.name.ng

# Admin
ADMIN_GITHUB_USERNAME=your_github_username

# Docker
DOCKER_SOCKET=/var/run/docker.sock
DEPLOYMENTS_PATH=/home/ubuntu/daspe/deployments-data

# Domain
BASE_DOMAIN=daspe.name.ng
